{
	"name": "@vite-deploy/internal-helpers",
	"version": "0.2.1",
	"description": "Internal helpers used by Vite Deploy packages.",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"exports": {
		".": {
			"default": "./dist/index.js"
		},
		"./test": {
			"default": "./dist/test/index.js"
		},
		"./types": "./types.d.ts"
	},
	"files": [
		"dist",
		"types.d.ts"
	],
	"scripts": {
		"dev": "tsc --build --force --watch",
		"build": "tsc --build --force",
		"test": "node --test --test-reporter=spec \"test/**/*.test.ts\""
	},
	"keywords": [
		"vite",
		"vite-plugin"
	],
	"author": "contact@florian-lefebvre.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/web-runes/vite-deploy.git",
		"directory": "packages/internal-helpers"
	},
	"bugs": "https://github.com/web-runes/vite-deploy/issues",
	"homepage": "https://vite-deploy.web-runes.dev",
	"license": "MIT",
	"peerDependencies": {
		"vite": "^8.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.9.5",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"sirv": "^3.0.2"
	}
}
